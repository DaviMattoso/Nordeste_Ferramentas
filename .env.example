# Copie este arquivo para um mecanismo de ambiente do servidor.
# A aplicação lê as variáveis com getenv(); um arquivo .env sozinho não as carrega.

NF_ROOT_URL=http://localhost/Nordeste_Ferramentas/nf_blog/
NF_DB_HOST=localhost
NF_DB_USER=root
NF_DB_PASS=
NF_DB_NAME=nf_blog

# O aluguel não reutiliza NF_DB_NAME. Um .env solto também não configura o PHP.
NF_ALUGUEL_ROOT_URL=http://localhost/aluguel/
NF_ALUGUEL_DB_HOST=localhost
NF_ALUGUEL_DB_USER=root
NF_ALUGUEL_DB_PASS=
NF_ALUGUEL_DB_NAME=nf_aluguel
