# Proteções iniciais do módulo para servidores Apache.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Impede acesso HTTP a configurações, documentação e dados internos.
    RewriteRule "^(?:config|database|docs|future|includes|storage)(?:/|$)" - [F,L,NC]

    # Bloqueia arquivos ocultos, incluindo os marcadores .gitkeep.
    RewriteRule "(^|/)\." - [F,L]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
