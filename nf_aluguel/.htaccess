# Proteções do Apache para o módulo de aluguel.
# O servidor embutido do PHP não lê este arquivo.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]

    # Configuração, SQL, documentação e uploads não são páginas públicas.
    RewriteRule "^(?:config|database|docs|uploads)(?:/|$)" - [F,L,NC]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
