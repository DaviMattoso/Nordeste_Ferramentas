# Proteções aplicadas pelo Apache ao diretório público do NF Blog.
# Mantém listagem de diretórios desativada, bloqueia arquivos internos e impede
# execução de scripts nas pastas que recebem avatars e thumbnails.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia arquivos ocultos, preservando apenas o caminho ACME usado por HTTPS.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]

    # Diretórios internos são acessíveis pelo PHP, mas nunca diretamente por HTTP.
    RewriteRule "^(?:config|admin/config|database|txt|\.vscode)(?:/|$)" - [F,L,NC]

    # Mesmo que um arquivo malicioso chegue ao upload, ele não pode executar como script.
    RewriteRule "^Images/(?:avatars|posts)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml)$" - [F,L,NC]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
