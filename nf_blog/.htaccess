Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Impede acesso HTTP a arquivos ocultos, preservando o caminho ACME usado por HTTPS.
    RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]

    # Estes diretórios existem apenas para inclusões PHP ou apoio ao desenvolvimento.
    RewriteRule "^(?:config|admin/config|database|txt|\.vscode)(?:/|$)" - [F,L,NC]

    # Defesa adicional: uploads de imagens nunca devem executar scripts.
    RewriteRule "^Images/(?:avatars|posts)/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml)$" - [F,L,NC]
</IfModule>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
